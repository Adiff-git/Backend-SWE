# Copy to .env.local and replace both secret placeholders before starting.
COMPOSE_PROJECT_NAME=backend-swe-local
LOCAL_DB_PORT=55433
LOCAL_DB_NAME=backend
LOCAL_DB_USER=backend
LOCAL_DB_PASSWORD=GENERATE_PRIVATE_VALUE
JWT_SECRET=GENERATE_PRIVATE_VALUE_AT_LEAST_32_BYTES
JWT_ISSUER=urn:backend-swe:local
SERVER_PORT=18081
LOCAL_STORAGE_PORT=14567
LOCAL_STORAGE_BUCKET=backend-images
LOCAL_MAILPIT_PORT=8025
# Browser-accessible URL; change together with LOCAL_STORAGE_PORT.
LOCAL_STORAGE_SIGNING_ENDPOINT=http://127.0.0.1:14567

# Enable only with complete identity/mail configuration. Google also requires verification proof keys.
GOOGLE_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=http://localhost:18081/login/oauth2/code/google
GOOGLE_FRONTEND_SUCCESS_URI=http://localhost:3000/auth/success
GOOGLE_FRONTEND_FAILURE_URI=http://localhost:3000/auth/failure
IDENTITY_ALLOWED_ORIGINS=http://localhost:3000
# Two independently generated base64 keys: HMAC >=32 bytes; AES-GCM exactly32 bytes.
VERIFICATION_HMAC_KEY=
VERIFICATION_ENCRYPTION_KEY=
VERIFICATION_KEY_ID=v1
VERIFICATION_MAIL_FROM=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
