@startchen master
title Single-vendor Store - Conceptual ER Model

left to right direction

entity "User" as User {
  displayName
  username
  password
  email
  phoneNumber
  accountStatus
  gender
  dateOfBirth
  joinedAt
}

entity "Role" as Role {
  roleName
}

entity "Permission" as Permission {
  permissionName
}

entity "Address" as Address {
  recipientName
  recipientPhone
  addressText
  isDefault
}

entity "Category" as Category {
  categoryName
}

entity "Product" as Product {
  productName
  description
  productStatus
}

entity "ProductVariant" as Variant {
  sku
  optionCombination
  sellingPrice
  weight
}

entity "Inventory" as Inventory {
  onHandQuantity
  reservedQuantity
}

entity "Cart" as Cart {
}

entity "Order" as Order {
  orderNumber
  placedAt
  currency
  orderStatus
  merchandiseTotal
  discountTotal
  shippingFee
  payableTotal
  recipientNameSnapshot
  recipientPhoneSnapshot
  deliveryAddressSnapshot
}

entity "OrderItem" as OrderItem <<associative>> {
  productNameSnapshot
  variantOptionsSnapshot
  unitPriceSnapshot
  quantity
  discountAmount
  lineTotal
}

entity "Payment" as Payment {
  paymentMethod
  providerReference
  amount
  paymentStatus
  paidAt
}

entity "Carrier" as Carrier {
  carrierName
}

entity "Shipment" as Shipment {
  trackingNumber
  shipmentStatus
  estimatedDeliveryAt
  shippedAt
  deliveredAt
}

entity "ShipmentTrackingEvent" as ShipmentTrackingEvent {
  status
  title
  description
  location
  occurredAt
}

entity "Voucher" as Voucher {
  title
  description
  voucherCode
  discountType
  discountValue
  minimumSpend
  maximumDiscount
  validFrom
  validUntil
  usageLimit
}

entity "Review" as Review {
  rating
  comment
  createdAt
}

entity "MediaAsset" as MediaAsset {
}

relationship "Has role" as HasRole {
}
User -(0,N)- HasRole
HasRole -(0,N)- Role

relationship "Grants permission" as GrantsPermission {
}
Role -(0,N)- GrantsPermission
GrantsPermission -(0,N)- Permission

relationship "Saves address" as SavesAddress {
}
User -(0,N)- SavesAddress
SavesAddress =(1,1)= Address

relationship "Owns media" as OwnsMedia {
}
User -(0,N)- OwnsMedia
OwnsMedia =(1,1)= MediaAsset

relationship "Parent of" as ParentCategory {
}
Category -(0,N)- ParentCategory
ParentCategory -(0,1)- Category

relationship "Classifies" as Classifies {
}
Category -(0,N)- Classifies
Classifies =(1,1)= Product

relationship "Has variant" as HasVariant {
}
Product =(1,N)= HasVariant
HasVariant =(1,1)= Variant

relationship "Tracks stock" as TracksStock {
}
Variant =(1,1)= TracksStock
TracksStock =(1,1)= Inventory

relationship "Owns cart" as OwnsCart {
}
User -(0,1)- OwnsCart
OwnsCart =(1,1)= Cart

relationship "Contains cart item" as ContainsCartItem {
  quantity
  addedAt
  isSelected
}
Cart -(0,N)- ContainsCartItem
Variant -(0,N)- ContainsCartItem

relationship "Places order" as PlacesOrder {
}
User -(0,N)- PlacesOrder
PlacesOrder =(1,1)= Order

relationship "Contains order item" as ContainsOrderItem {
}
Order =(1,N)= ContainsOrderItem
ContainsOrderItem =(1,1)= OrderItem

relationship "Purchases variant" as PurchasesVariant {
}
Variant -(0,N)- PurchasesVariant
PurchasesVariant =(1,1)= OrderItem

relationship "Records payment" as RecordsPayment {
}
Order -(0,N)- RecordsPayment
RecordsPayment =(1,1)= Payment

relationship "Ships in" as ShipsIn {
}
Order -(0,N)- ShipsIn
ShipsIn =(1,1)= Shipment

relationship "Delivers shipment" as DeliversShipment {
}
Carrier -(0,N)- DeliversShipment
DeliversShipment =(1,1)= Shipment

relationship "Packs item" as PacksItem {
  quantity
}
Shipment =(1,N)= PacksItem
PacksItem -(0,N)- OrderItem

relationship "Records tracking event" as RecordsTrackingEvent {
}
Shipment -(0,N)- RecordsTrackingEvent
RecordsTrackingEvent =(1,1)= ShipmentTrackingEvent

relationship "Allocates voucher" as AllocatesVoucher {
  quantity
}
User -(0,N)- AllocatesVoucher
AllocatesVoucher -(0,N)- Voucher

relationship "Applies voucher" as AppliesVoucher {
}
Cart -(0,1)- AppliesVoucher
Voucher -(0,N)- AppliesVoucher

relationship "Redeems voucher" as RedeemsVoucher {
  appliedDiscount
  redeemedAt
  redemptionStatus
}
Voucher -(0,N)- RedeemsVoucher
RedeemsVoucher -(0,1)- Order

relationship "Has review" as HasReview {
}
OrderItem -(0,1)- HasReview
HasReview =(1,1)= Review

relationship "Writes review" as WritesReview {
}
User -(0,N)- WritesReview
WritesReview =(1,1)= Review

relationship "Adds to wishlist" as AddsToWishlist {
  addedAt
}
User -(0,N)- AddsToWishlist
AddsToWishlist -(0,N)- Product

' PlacesOrder:
'  Checkout creates one Order from selected cart items.
'  Cart items are not grouped or split by seller.
'  Order retains totals and delivery snapshots after cart cleanup.

' RedeemsVoucher:
'  Voucher usage is retained on Order after cart cleanup.
'  The voucher must be allocated to the ordering User.
'  The server calculates the applied discount.

' AllocatesVoucher:
'  quantity is the remaining number of uses for this User.

' AppliesVoucher:
'  The selected voucher must have an allocation for the Cart owner.

' User:
'  Accounts use local username/email and password authentication.
'  Roles and permissions distinguish customers and administrators.

@endchen
